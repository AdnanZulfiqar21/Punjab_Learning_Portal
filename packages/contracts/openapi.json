    "/v1/grades/{grade}/subjects/{subject}/book": {
      "get": {
        "operationId": "book_for_v1_grades__grade__subjects__subject__book_get",
        "parameters": [
          {
            "in": "path",
            "name": "grade",
            "required": true,
            "schema": {
              "maximum": 12,
              "minimum": 11,
              "title": "Grade",
              "type": "integer"
            }
          },
          {
            "in": "path",
            "name": "subject",
            "required": true,
            "schema": {
              "maxLength": 40,
              "minLength": 2,
              "title": "Subject",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
