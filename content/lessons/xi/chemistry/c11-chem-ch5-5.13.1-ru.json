        "blocks": [
          {
            "type": "paragraph",
            "text": "Liquid crystals ki aam properties yeh hain:"
          },
          {
            "type": "heading",
            "level": 3,
            "text": "Liquid crystals"
          },
          {
            "type": "list",
            "ordered": true,
            "items": [
              "parallel aur ba-tarteeb tarteeb rakhte hain.",
              "lambe, rod jaise aur seedhe (linear) hote hain.",
              "liquids ki tarah behte (flow karte) hain.",
              "liquids ki tarah viscosity dikhate hain.",
              "crystals ki tarah optical properties (roshni se mutaliq khusoosiyat) dikhate hain.",
              "kuch had tak sakht (rigid) hote hain.",
              "hamesha anisotropic hote hain (properties simt par munhasir)."
            ]
          },
          {
