            "type": "table",
            "caption": "Identification of ammonium radical",
            "header": [
              "Experiment",
              "Observation",
              "Inference"
            ],
            "rows": [
              [
                "Take 4 g of sample in a clean test tube. Dissolve it in 10 cm³ distilled water. Add NaOH solution and gently heat it.",
                "Ammonia gas is evolved with a distinct smell. Ammonia gas turns moist red litmus blue.",
                "NH₄¹⁺ ions are indicated."
              ]
            ]
          },
          {
            "type": "equation",
            "latex": "\\ce{NH4^{1+}_{(aq)} + OH^{1-}_{(aq)} -> NH3_{(g)} + H2O_{(l)}}",
            "text_alt": "NH₄¹⁺(aq) + OH¹⁻(aq) → NH₃(g) + H₂O(l)"
          }
        ]
