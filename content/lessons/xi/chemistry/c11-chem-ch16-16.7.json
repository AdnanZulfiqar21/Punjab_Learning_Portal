      "body": {
        "blocks": [
          {
            "type": "heading",
            "level": 3,
            "text": "a) Identification of Aluminium (Al³⁺) radical"
          },
          {
            "type": "paragraph",
            "text": "Take 4 g of solid sample in a clean test tube. Dissolve it in about 10 cm³ distilled water. Divide this solution into two parts for further tests."
          },
          {
            "type": "table",
            "caption": "Identification of aluminium radical",
            "header": [
              "Experiment",
              "Observation",
              "Inference"
            ],
            "rows": [
              [
                "To one part, add about 5 cm³ NaOH solution.",
                "A white gelatinous precipitate is formed.",
                "Al³⁺ ions are indicated."
              ],
              [
                "To the second part of the above solution, add a few drops of aqueous ammonia.",
                "A white precipitate is formed.",
                "Al³⁺ ions are indicated"
              ]
            ],
            "caption_hidden": true
          },
          {
            "type": "equation",
            "latex": "\\ce{Al^{3+}_{(aq)} + 3OH^{1-}_{(aq)} -> $\\underset{\\text{white ppt}}{\\ce{Al(OH)3_{(s)}}}$}",
            "text_alt": "Al³⁺(aq) + 3OH¹⁻(aq) → Al(OH)₃(s) (white ppt)"
          }
        ]
      }
    }
  ]
