        "blocks": [
          {
            "type": "callout",
            "tone": "definition",
            "title": "Alkanes",
            "text": "Alkanes are saturated hydrocarbons with the general formula CnH2n+2. Methane, CH4, is the simplest member of the family."
          },
          {
