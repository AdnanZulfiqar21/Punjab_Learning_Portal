            "type": "callout",
            "tone": "definition",
            "title": "Homogeneous equilibrium",
            "text": "Woh equilibrium system jis mein tamam reactants aur products ek hi phase (halat) mein hon."
          },
          {
            "type": "paragraph",
            "text": "Homogeneous equilibria ki examples (misalein):"
          },
          {
            "type": "equation",
            "latex": "\\ce{N2_{(g)} + 3H2_{(g)} <=> 2NH3_{(g)}}",
            "text_alt": "N₂(g) + 3H₂(g) ⇌ 2NH₃(g)"
          },
          {
            "type": "equation",
            "latex": "\\ce{2SO2_{(g)} + O2_{(g)} <=> 2SO3_{(g)}}",
            "text_alt": "2SO₂(g) + O₂(g) ⇌ 2SO₃(g)"
          },
          {
            "type": "equation",
            "latex": "\\ce{CH3COOH_{(l)} + C2H5OH_{(l)} <=> CH3COOC2H5_{(l)} + H2O_{(l)}}",
            "text_alt": "CH₃COOH(l) + C₂H₅OH(l) ⇌ CH₃COOC₂H₅(l) + H₂O(l)"
          }
        ]
      }
    }
