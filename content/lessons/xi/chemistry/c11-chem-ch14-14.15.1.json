      "body": {
        "blocks": [
          {
            "type": "paragraph",
            "text": "Common rules and regulations to control air pollution in Pakistan is given below:"
          },
          {
            "type": "list",
            "ordered": true,
            "items": [
              "Pakistan Environmental Protection Act (PEPA 1997)",
              "Natural Environmental Quality Standard (NEQS)",
              "Punjab Environmental Protection (Amendment) Act 2012"
            ],
            "book_errors": [
              "Natural Environmental Quality Standard (NEQS)"
            ]
          },
          {
            "type": "callout",
            "tone": "correction",
            "title": "Book correction",
            "text": "NEQS stands for National Environmental Quality Standards, the national limits set under PEPA 1997, not “Natural”."
          }
        ]
      }
    }
  ]
}
