  "items": [
    {
      "external_id": "C11-CHEM-CH11-11.6.1",
      "chapter": "pk-punjab/xi/chemistry/c11-chem/ch11",
      "topic": "pk-punjab/xi/chemistry/c11-chem/ch11/11.6.1",
      "title": "11.6.1 Nomenclature of alkenes",
      "language": "en",
      "source_refs": [
        {
          "source_document_id": "b07b1f6c-f5a4-509d-ae86-73be5bffb0d4",
          "pdf_from": 255,
          "pdf_to": 255,
          "note": "Topic 11.6.1 with the printed naming examples as formulas, printed page 255."
        }
      ],
      "body": {
        "blocks": [
          {
            "type": "callout",
            "tone": "definition",
            "title": "Unsaturated hydrocarbons",
            "text": "Alkenes are unsaturated hydrocarbons, unsaturated hydrocarbons are compounds of hydrogen and carbon only whose molecules contain carbon to carbon double bonds (or triple bonds)."
          },
          {
            "type": "paragraph",
            "text": "Alkenes have two hydrogen atoms less than the corresponding saturated hydrocarbons."
          },
          {
            "type": "paragraph",
            "text": "The IUPAC rules for naming alkenes are similar in many respects to those for naming alkanes."
          },
          {
            "type": "list",
            "ordered": true,
            "marker": "1.",
            "items": [
              "Select the longest continuous chain that contains the C = C as the parent chain. Change the ending of the name of the alkane of identical length from — ane to — ene, e.g.,"
            ]
          },
          {
            "type": "equation",
            "latex": "\\ce{H3C-CH2-CH2-C(CH2-CH2-CH3)=CH-CH3}\\qquad \\text{3-n-Propyl 2-hexene}",
            "text_alt": "H₃C–CH₂–CH₂–C(CH₂–CH₂–CH₃)=CH–CH₃   (3-n-Propyl 2-hexene)"
          },
          {
            "type": "list",
            "ordered": true,
            "start": 2,
            "marker": "1.",
            "items": [
              "Number the chain so as to include both carbon atoms of the double bond. Numbering begins from the end nearer to the double bond."
            ]
          },
          {
            "type": "equation",
            "latex": "\\ce{H3C-CH(CH3)-CH2-CH=CH-CH3}\\qquad \\text{5-Methyl 2-hexene}",
            "text_alt": "H₃C–CH(CH₃)–CH₂–CH=CH–CH₃   (5-Methyl 2-hexene)"
          },
          {
            "type": "list",
            "ordered": true,
            "start": 3,
            "marker": "1.",
            "items": [
              "Designate the location of the double bond by using the number of the first atom of the double bond as a prefix."
            ]
          },
          {
            "type": "equation",
            "latex": "\\ce{H2C=CH-CH2-CH3}\\qquad \\text{1-butene}",
            "text_alt": "H₂C=CH–CH₂–CH₃   (1-butene)"
          },
          {
            "type": "equation",
            "latex": "\\ce{H2C=CH-CH2-CH2-CH3}\\qquad \\text{1-pentene}",
            "text_alt": "H₂C=CH–CH₂–CH₂–CH₃   (1-pentene)"
          },
          {
            "type": "list",
            "ordered": true,
            "start": 4,
            "marker": "1.",
            "items": [
              "Indicate the locations of the substituent groups by the numbers of the carbon atoms to which they are attached."
            ]
          },
          {
            "type": "equation",
            "latex": "\\ce{H3C-C(CH3)=CH-CH3}\\qquad \\text{2-Methyl-2-butene}",
            "text_alt": "H₃C–C(CH₃)=CH–CH₃   (2-Methyl-2-butene)"
          },
          {
            "type": "equation",
            "latex": "\\ce{H3C-C(CH3)=CH-CH2-C(CH3)2-CH3}\\qquad \\text{2, 5, 5-Trimethyl-2-hexene}",
            "text_alt": "H₃C–C(CH₃)=CH–CH₂–C(CH₃)₂–CH₃   (2, 5, 5-Trimethyl-2-hexene)"
          },
          {
            "type": "list",
            "ordered": true,
            "start": 5,
            "marker": "1.",
            "items": [
              "If the parent chain contains more than one double bonds, they are alkadienes for two, alkatrienes for three and so on."
            ]
          }
        ]
      }
    }
  ]
}
