                "Large (10⁻²)",
                "Very strong"
              ],
              [
                "HSO₄⁻",
                "HSO₄ ⇌ H⁺ + SO₄²⁻",
                "1.3 x 10⁻⁴",
                "Strong"
              ],
              [
                "HF",
                "HF ⇌ H⁺ + F⁻",
                "6.7 x 10⁻⁵",
                "Week"
              ],
              [
                "CH₃COOH",
                "CH₃COOH ⇌ H⁺ + CH₃COO⁻",
                "1.85 x 10⁻⁵",
                "Week"
              ],
              [
                "H₂CO₃",
                "H₂CO₃ ⇌ H⁺ + HS⁻",
                "4.4 x 10⁻⁷",
                "Week"
              ],
              [
