        "blocks": [
          {
            "type": "paragraph",
            "text": "Pressure kam karne ya volume barhane se reaction us taraf jati hai jahan zyada volume ho (zyada gas moles). Ammonia ki reaction reverse taraf shift hoti hai."
          },
          {
            "type": "heading",
            "level": 3,
            "text": "Quick Check 8.6"
          },
          {
            "type": "paragraph",
            "text": "In reactions mein volume ya pressure badalne se sirf equilibrium ki position badalti hai, equilibrium constant nahi. Har reaction ki direction kaise badlegi?"
          },
          {
            "type": "equation",
            "latex": "\\ce{2H2_{(g)} + O2_{(g)} <=> 2H2O_{(g)}} \\quad (\\text{Increasing } P)",
            "text_alt": "2H₂(g) + O₂(g) ⇌ 2H₂O(g) (Increasing P)"
          },
          {
            "type": "equation",
            "latex": "\\ce{2CO_{(g)} + O2_{(g)} <=> 2CO2_{(g)}} \\quad (\\text{Increasing } V)",
            "text_alt": "2CO(g) + O₂(g) ⇌ 2CO₂(g) (Increasing V)"
          },
          {
            "type": "equation",
            "latex": "\\ce{N2O4_{(g)} <=> 2NO2_{(g)}} \\quad (\\text{Increasing } P)",
            "text_alt": "N₂O₄(g) ⇌ 2NO₂(g) (Increasing P)"
          },
          {
            "type": "equation",
            "latex": "\\ce{2SO2_{(g)} + O2_{(g)} <=> 2SO3_{(g)}} \\quad (\\text{Increasing } V)",
            "text_alt": "2SO₂(g) + O₂(g) ⇌ 2SO₃(g) (Increasing V)"
