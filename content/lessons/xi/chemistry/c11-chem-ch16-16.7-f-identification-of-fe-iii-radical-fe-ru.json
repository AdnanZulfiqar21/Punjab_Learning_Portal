      "body": {
        "blocks": [
          {
            "type": "paragraph",
            "text": "Saaf test tube mein 2 g FeCl₃ lein. 10 cm³ distilled water mein ghol lein. Do hisson (parts) mein baant lein."
          },
          {
            "type": "table",
            "caption": "Iron (III) radical ki pehchan",
            "header": [
              "Experiment",
              "Observation",
              "Inference"
            ],
            "rows": [
              [
                "Pehle hisse mein NaOH solution dalein.",
                "Orange-bhoora precipitate banta hai.",
                "Fe³⁺ ions present hain."
              ],
              [
                "Doosre hisse mein aqueous ammonia dalein.",
                "Orange-bhoora precipitate banta hai.",
                "Fe³⁺ ions present hain."
              ]
            ]
          },
          {
            "type": "equation",
            "latex": "\\ce{Fe^{3+}_{(aq)} + 3OH^-_{(aq)} -> $\\underset{\\text{Orange brown ppt}}{\\ce{Fe(OH)3_{(s)}}}$}",
            "text_alt": "Fe³⁺(aq) + 3OH⁻(aq) → Fe(OH)₃(s) (Orange brown ppt)"
          }
        ]
      }
    }
