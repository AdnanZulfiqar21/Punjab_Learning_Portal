      "title": "6.3.3 Enthalpy change of formation (ΔH°f)",
      "language": "en",
      "source_refs": [
        {
          "source_document_id": "b07b1f6c-f5a4-509d-ae86-73be5bffb0d4",
          "pdf_from": 121,
          "pdf_to": 121,
          "note": "Topic 6.3.3, printed page 121."
        }
      ],
      "body": {
        "blocks": [
          {
            "type": "paragraph",
            "text": "Standard enthalpy change of formation of a compound is the enthalpy change involved when one mole of the compound is formed from its elements under standard conditions.",
            "bold": [
              "one mole"
            ],
            "highlight": [
              "Standard enthalpy change of formation of a compound is the enthalpy change involved when one mole of the compound is formed from its elements under standard conditions."
            ]
          },
          {
            "type": "paragraph",
            "text": "It can be exothermic or endothermic. For instance, ΔH°f for methane is given below.",
            "bold": [
              "ΔH°f"
            ]
          },
          {
            "type": "equation",
            "latex": "\\ce{C_{(s)} + 2H2_{(g)} -> CH4_{(g)}}\\qquad \\Delta H^\\circ_f = -74.8\\ \\text{kJ mol}^{-1}",
            "text_alt": "C(s) + 2H₂(g) → CH₄(g)    ΔH°f = –74.8 kJ mol⁻¹"
          }
        ]
      }
    }
  ]
}
