    {
      "external_id": "C11-CHEM-CH10-10.9",
      "chapter": "pk-punjab/xi/chemistry/c11-chem/ch10",
      "topic": "pk-punjab/xi/chemistry/c11-chem/ch10/10.9",
      "title": "10.9 Amount of substance produced during electrolysis",
      "language": "en",
      "source_refs": [
        {
          "source_document_id": "b07b1f6c-f5a4-509d-ae86-73be5bffb0d4",
          "pdf_from": 222,
          "pdf_to": 222,
          "note": "Topic 10.9 with Sample Problem 10.5, printed page 222."
        }
      ],
      "body": {
        "blocks": [
          {
            "type": "paragraph",
            "text": "The value of F can be used to calculate the mass of substance deposited at an electrode and the volume of gas produced at an electrode."
          },
          {
            "type": "heading",
            "level": 4,
            "text": "Sample Problems 10.5"
          },
          {
            "type": "paragraph",
            "text": "Calculate the mass of lead (Pb) deposited at the cathode during electrolysis when a current of 1.50 A flows through molten lead(II) bromide (PbBr₂) for 20.0 min. (relative atomic mass, Ar value: [Pb] = 207; F = 96500 C mol⁻¹)"
          },
          {
            "type": "paragraph",
            "text": "Solution:",
            "bold": [
              "Solution:"
            ]
          },
          {
            "type": "paragraph",
            "text": "Step 1 Write the half-equation for the reaction.",
            "bold": [
              "Step 1"
            ]
          },
          {
            "type": "paragraph",
            "text": "Pb²⁺(aq) + 2e⁻ → Pb(s)"
          },
          {
            "type": "paragraph",
            "text": "Step 2 Find the number of coulombs required to deposit 1 mole of product at the electrode.",
            "bold": [
              "Step 2"
            ]
          },
          {
            "type": "paragraph",
            "text": "2 moles of electrons are required per mole of Pb formed"
          },
          {
            "type": "paragraph",
            "text": "= 2F"
          },
          {
            "type": "paragraph",
            "text": "= 2 × 96500"
          },
          {
            "type": "paragraph",
            "text": "= 193000 C mol⁻¹"
          },
          {
            "type": "paragraph",
            "text": "Step 3 Calculate the charge transferred during the electrolysis.",
            "bold": [
              "Step 3"
            ]
          },
          {
            "type": "paragraph",
            "text": "Q = I × t = 1.50 × 20 × 60 = 1800 C"
          },
          {
            "type": "paragraph",
            "text": "Step 4 Calculate the mass by simple proportion using the relative atomic mass.",
            "bold": [
              "Step 4"
            ]
          },
          {
            "type": "paragraph",
            "text": "193000 C deposits 1 mole Pb, which is 207 g Pb"
          },
          {
            "type": "paragraph",
            "text": "so, 1800 C deposits = 1.93 g Pb"
          }
        ]
      }
    }
  ]
}
