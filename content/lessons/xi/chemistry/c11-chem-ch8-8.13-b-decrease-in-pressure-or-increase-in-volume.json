    {
      "external_id": "C11-CHEM-CH8-8.13-B-DECREASE-IN-PRESSURE-OR-INCREASE-IN-VOLUME",
      "chapter": "pk-punjab/xi/chemistry/c11-chem/ch8",
      "topic": "pk-punjab/xi/chemistry/c11-chem/ch8/u-b-decrease-in-pressure-or-increase-in-volume",
      "title": "b) Decrease in pressure or increase in volume:",
      "language": "en",
      "source_refs": [
        {
          "source_document_id": "b07b1f6c-f5a4-509d-ae86-73be5bffb0d4",
          "pdf_from": 181,
          "pdf_to": 181,
          "note": "b) Decrease in pressure or increase in volume:: a main subheading of 8.13 The effect of a change in pressure or volume, its own page (owner 2026-11-04); PDF 181-181."
        }
      ],
      "body": {
        "blocks": [
          {
            "type": "paragraph",
            "text": "If the pressure is decreased or volume is increased, the reaction will move to that side, where the reaction occupies greater volume. Ammonia synthesis is shifted to the reverse direction."
          },
          {
            "type": "heading",
            "level": 3,
            "text": "Quick Check 8.6"
          },
          {
            "type": "paragraph",
            "text": "The change of volume or pressure for the following reactions only changes the equilibrium position but not the equilibrium constant. How the direction of reaction changes for each of the following reactions."
          },
          {
            "type": "equation",
            "latex": "\\ce{2H2_{(g)} + O2_{(g)} <=> 2H2O_{(g)}} \\quad (\\text{Increasing } P)",
            "text_alt": "2H₂(g) + O₂(g) ⇌ 2H₂O(g) (Increasing P)"
          },
          {
            "type": "equation",
            "latex": "\\ce{2CO_{(g)} + O2_{(g)} <=> 2CO2_{(g)}} \\quad (\\text{Increasing } V)",
            "text_alt": "2CO(g) + O₂(g) ⇌ 2CO₂(g) (Increasing V)"
          },
          {
            "type": "equation",
            "latex": "\\ce{N2O4_{(g)} <=> 2NO2_{(g)}} \\quad (\\text{Increasing } P)",
            "text_alt": "N₂O₄(g) ⇌ 2NO₂(g) (Increasing P)"
          },
          {
            "type": "equation",
            "latex": "\\ce{2SO2_{(g)} + O2_{(g)} <=> 2SO3_{(g)}} \\quad (\\text{Increasing } V)",
            "text_alt": "2SO₂(g) + O₂(g) ⇌ 2SO₃(g) (Increasing V)"
          }
        ]
      }
    }
  ]
}
