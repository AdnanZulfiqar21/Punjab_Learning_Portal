      "chapter": "pk-punjab/xi/physics/c11-phy/ch2",
      "topic": "pk-punjab/xi/physics/c11-phy/ch2/u-kinetic-energy",
      "title": "Kinetic Energy (Roman Urdu)",
      "language": "roman_ur",
      "variant_of": "C11-PHY-CH2-2.11-KINETIC-ENERGY",
      "source_refs": [
        {
          "source_document_id": "e2c5c034-041b-5340-9823-5e3c8c88a07c",
          "pdf_from": 46,
          "pdf_to": 46,
          "note": "Kinetic Energy: a main subheading of 2.11 Inelastic collision in two dimensions, its own page (owner 2026-11-04); PDF 46-46."
        }
      ],
      "body": {
        "blocks": [
          {
            "type": "paragraph",
            "text": "Collision inelastic hai, is liye system ki kinetic energy conserved nahi rehti. Loss (nuqsan) yun nikalte hain:"
          },
          {
            "type": "heading",
            "level": 4,
            "text": "Initial Kinetic Energy (shuru ki kinetic energy)"
          },
          {
            "type": "paragraph",
            "text": "Collision se pehle system ki total kinetic energy:"
          },
          {
            "type": "equation",
            "latex": "(K.E)_i = \\frac{1}{2}m_1v_{1i}^2 + \\frac{1}{2}m_2v_{2i}^2 \\tag{2.43}",
            "text_alt": "(K.E)i = ½m₁v₁i² + ½m₂v₂i²   (2.43)"
          },
          {
            "type": "paragraph",
            "text": "K.E. scalar hai, is liye is formula mein velocities ko components mein torne ki zaroorat nahi; seedhi speed lagti hai."
          },
          {
            "type": "heading",
            "level": 4,
            "text": "Final Kinetic Energy (aakhri kinetic energy)"
          },
          {
            "type": "paragraph",
            "text": "Collision ke baad (jab cheezen chipak jayen) total kinetic energy:"
          },
          {
            "type": "equation",
            "latex": "(K.E)_f = \\frac{1}{2}Mv_f^2 \\tag{2.44}",
            "text_alt": "(K.E)f = ½Mvf²   (2.44)"
          },
          {
            "type": "paragraph",
            "text": "Yahan vf final velocity ki magnitude hai jo Eq. (2.41) se milti hai."
          }
        ]
      }
    }
  ]
}
