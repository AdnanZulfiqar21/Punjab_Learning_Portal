    {
      "external_id": "C11-PHY-CH6-6.1-IDEAL-GAS-EQUATION-IN-TERMS-OF-BOLTZMANN-CONSTANT-RU",
      "chapter": "pk-punjab/xi/physics/c11-phy/ch6",
      "topic": "pk-punjab/xi/physics/c11-phy/ch6/u-ideal-gas-equation-in-terms-of-boltzmann-constant",
      "title": "Ideal Gas Equation in Terms of Boltzmann Constant (Roman Urdu)",
      "language": "roman_ur",
      "variant_of": "C11-PHY-CH6-6.1-IDEAL-GAS-EQUATION-IN-TERMS-OF-BOLTZMANN-CONSTANT",
      "source_refs": [
        {
          "source_document_id": "e2c5c034-041b-5340-9823-5e3c8c88a07c",
          "pdf_from": 119,
          "pdf_to": 119,
          "note": "Ideal Gas Equation in Terms of Boltzmann Constant: a main subheading of 6.1 Assumptions of the kinetic theory of gases, its own page (owner 2026-11-04); PDF 119-119."
        }
      ],
      "body": {
        "blocks": [
          {
            "type": "paragraph",
            "text": "Ideal gas equation se:"
          },
          {
            "type": "equation",
            "latex": "PV = nRT \\qquad \\ldots\\ (\\text{i})",
            "text_alt": "PV = nRT ... (i)"
          },
          {
            "type": "paragraph",
            "text": "Yahan n ideal gas ke moles ki number hai: atoms ya molecules ki number ko Avogadro's number (Nₐ = 6.02 × 10²³) se divide karne se n milta hai."
          },
          {
            "type": "paragraph",
            "text": "Yani:"
          },
          {
            "type": "equation",
            "latex": "n = \\frac{N}{N_A} \\qquad \\ldots\\ (\\text{ii})",
            "text_alt": "n = N/Nₐ ... (ii)"
          },
          {
            "type": "paragraph",
            "text": "Eq. (ii) ko Eq. (i) mein rakhne se:"
          },
          {
            "type": "equation",
            "latex": "PV = \\frac{N}{N_A}RT \\qquad \\ldots\\ (\\text{iii})",
            "text_alt": "PV = (N/Nₐ) RT ... (iii)"
          },
          {
            "type": "paragraph",
            "text": "R/Nₐ ko Boltzmann constant k_B kehte hain."
          },
          {
            "type": "callout",
            "tone": "note",
            "title": "For Your Information",
            "text": "Real gases in halaat mein ideal gas jaisi ban jati hain:\n(i) low pressure par\n(ii) high temperature par"
          },
          {
            "type": "paragraph",
            "text": "Yani:"
          },
          {
            "type": "equation",
            "latex": "k_B = \\frac{R}{N_A} \\qquad \\ldots\\ (6.2)",
            "text_alt": "k_B = R/Nₐ ... (6.2)"
          },
          {
            "type": "paragraph",
            "text": "R aur Nₐ ki values rakhne se:"
          },
          {
            "type": "equation",
            "latex": "k_B = 1.38 \\times 10^{-23}\\ \\text{J K}^{-1}",
            "text_alt": "k_B = 1.38 × 10⁻²³ J K⁻¹"
          },
          {
            "type": "paragraph",
            "text": "Eq. (6.2) ko Eq. (iii) mein rakhne se:"
          },
          {
            "type": "equation",
            "latex": "PV = N k_B T \\qquad \\ldots\\ (6.3)",
            "text_alt": "PV = N k_B T ... (6.3)"
          },
          {
            "type": "paragraph",
            "text": "Equation (6.3) Boltzmann constant ki shakal mein ideal gas equation hai. Is mein moles (n) ki jagah molecules ki number (N) aati hai."
          },
          {
            "type": "example",
            "title": "Example 6.1",
            "problem": "Ideal gas ka ek mole 300 K temperature par hai. Boltzmann constant 1.38 × 10⁻²³ J K⁻¹ ho to 1 atm pressure par gas ka volume nikalein. [1 atm = 101325 Pa]",
            "steps": [
              "PV = nRT, aur R = Nₐ × k_B (kyun ke k_B = R/Nₐ).",
              "Is liye V = n × Nₐ × k_B × T / P",
              "= 1 mol × 6.02 × 10²³ mol⁻¹ × 1.38 × 10⁻²³ J K⁻¹ × 300 K / 101325 Pa",
              "6.02 × 10²³ × 1.38 × 10⁻²³ = 8.31; 8.31 × 300 = 2492; 2492 / 101325 = 0.0246",
              "V ≈ 0.03 m³"
            ],
            "answer": "Gas ka volume taqreeban 0.03 m³ hai."
          }
        ]
      }
    }
  ]
}
