    {
      "external_id": "C11-PHY-CH2-2.4-DERIVATION-OF-THIRD-EQUATION-OF-MOTION-RU",
      "chapter": "pk-punjab/xi/physics/c11-phy/ch2",
      "topic": "pk-punjab/xi/physics/c11-phy/ch2/u-derivation-of-third-equation-of-motion",
      "title": "Derivation of third equation of motion (Roman Urdu)",
      "language": "roman_ur",
      "variant_of": "C11-PHY-CH2-2.4-DERIVATION-OF-THIRD-EQUATION-OF-MOTION",
      "source_refs": [
        {
          "source_document_id": "e2c5c034-041b-5340-9823-5e3c8c88a07c",
          "pdf_from": 28,
          "pdf_to": 28,
          "note": "Derivation of third equation of motion: a main subheading of 2.4 Equations of motion, its own page (owner 2026-11-04); PDF 28-28."
        }
      ],
      "body": {
        "blocks": [
          {
            "type": "paragraph",
            "text": "Ek body straight line mein initial velocity vi se chal kar time t mein final velocity vf tak pohanchti hai, aur is dauran us ka displacement S hai. To:"
          },
          {
            "type": "equation",
            "latex": "\\text{Displacement} = \\left(\\frac{\\text{Initial velocity} + \\text{Final velocity}}{2}\\right) \\times \\text{Time}",
            "text_alt": "Displacement = ((Initial velocity + Final velocity)/2) × Time"
          },
          {
            "type": "equation",
            "latex": "S = \\frac{(v_i + v_f)}{2} \\times t",
            "text_alt": "S = (vi + vf)/2 × t"
          },
          {
            "type": "equation",
            "latex": "2S = (v_i + v_f) \\times t \\tag{2.15}",
            "text_alt": "2S = (vi + vf) × t   (2.15)"
          },
          {
            "type": "paragraph",
            "text": "Pehli equation se t nikalein:"
          },
          {
            "type": "equation",
            "latex": "v_f = v_i + at",
            "text_alt": "vf = vi + at"
          },
          {
            "type": "equation",
            "latex": "\\text{or}\\quad t = \\frac{v_f - v_i}{a}",
            "text_alt": "or t = (vf - vi)/a"
          },
          {
            "type": "paragraph",
            "text": "t ki yeh value Eq. (2.15) mein rakhein. (vf + vi)(vf - vi) = vf² - vi² hota hai, is liye:"
          },
          {
            "type": "equation",
            "latex": "2S = (v_i + v_f)\\left(\\frac{v_f - v_i}{a}\\right) \\quad\\text{or}\\quad 2S = (v_f + v_i)\\left(\\frac{v_f - v_i}{a}\\right)",
            "text_alt": "2S = (vi + vf)((vf - vi)/a) or 2S = (vf + vi)((vf - vi)/a)"
          },
          {
            "type": "equation",
            "latex": "2aS = v_f^2 - v_i^2",
            "text_alt": "2aS = vf² - vi²"
          },
          {
            "type": "paragraph",
            "text": "Yeh teesri equation of motion hai. Is mein time t nahi aata."
          }
        ]
      }
    }
  ]
}
