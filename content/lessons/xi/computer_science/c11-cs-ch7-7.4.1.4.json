      "body": {
        "blocks": [
          {
            "type": "paragraph",
            "text": "Primary sources are original materials that have not been altered."
          },
          {
            "type": "paragraph",
            "text": "Example: A research paper written by scientists who conducted the study is a primary source. In contrast, a summary of the research written by someone else would be a secondary source."
          }
        ]
      }
    }
  ]
}
