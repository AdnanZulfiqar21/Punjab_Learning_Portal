      "title": "5.2.1 Measures of Central Tendency (Mean, Median, Mode) (Roman Urdu)",
      "language": "roman_ur",
      "variant_of": "C11-CS-CH5-5.2.1",
      "source_refs": [
        {
          "source_document_id": "8edd9572-2b0a-521f-a398-b6e8104a4eb3",
          "pdf_from": 128,
          "pdf_to": 128,
          "note": "Roman Urdu explanation of central tendency (PDF 128)."
        }
      ],
      "body": {
        "blocks": [
          {
            "type": "paragraph",
            "text": "Markazi rujhan ke paimane data ka markaz ya aam qeemat dhoondte hain. Teen hain: mean, median aur mode."
          },
          {
            "type": "table",
            "caption": "Mean, median aur mode",
            "header": [
              "Paimana",
              "Kaise nikalein",
              "Misal"
            ],
            "rows": [
              [
                "Mean",
                "tamam qeematein jama kar ke tadaad se taqseem",
                "50, 60, 70, 80, 90: 350 / 5 = 70"
              ],
              [
                "Median",
                "tarteeb mein beech wali qeemat; juft tadaad mein beech ki do ka ausat",
                "50, 60, 70, 80, 90: 70; 50, 60, 70, 80: (60 + 70) / 2 = 65"
              ],
              [
                "Mode",
                "sab se zyada aane wali qeemat; ek se zyada ho sakti hai",
                "50, 60, 70, 70, 90: 70; 50, 60, 70, 70, 60, 90: 60 aur 70"
              ]
            ]
          },
          {
            "type": "checkpoint",
            "mode": "self_check",
            "prompt": "4, 7, 7, 9, 13 ka mean, median aur mode nikalein.",
            "explanation": "Mean = 40 / 5 = 8; median = 7 (beech wali qeemat); mode = 7."
          },
          {
            "type": "heading",
            "level": 2,
            "text": "Fauri khulasa"
          },
          {
            "type": "list",
            "ordered": false,
            "items": [
              "Mean: ausat; median: beech ki qeemat; mode: sab se zyada aane wali qeemat."
            ]
          }
        ]
      }
    }
  ]
