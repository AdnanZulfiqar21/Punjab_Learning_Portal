      "body": {
        "blocks": [
          {
            "type": "paragraph",
            "text": "To read a file, open it with open(), read its contents and close it to free resources. The with statement closes the file automatically, even if an error occurs."
          },
          {
            "type": "callout",
            "tone": "note",
            "title": "Python code (each .... is one 4-space indent)",
            "text": "with open(\"example.txt\", \"r\") as file:\n....content = file.read()\n....print(content)"
          },
          {
            "type": "checkpoint",
            "mode": "self_check",
            "prompt": "What does the \"r\" in open(\"example.txt\", \"r\") mean?",
            "explanation": "Read mode: the file is opened for reading only and must already exist."
          },
          {
            "type": "heading",
            "level": 2,
            "text": "Quick recap"
          },
          {
            "type": "list",
            "ordered": false,
            "items": [
              "with open(name, \"r\") as file: content = file.read(); the file closes automatically."
            ]
          }
        ]
      }
