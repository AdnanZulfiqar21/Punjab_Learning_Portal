            "type": "list",
            "ordered": false,
            "items": [
              "Error metrics: how much predictions differ from actual values. If a grocery model predicts 8,000 rupees and the actual bill is 10,000, the error is 2,000 rupees.",
              "Accuracy metrics: how many predictions were correct. For a pass/fail model, accuracy is how often it was right."
            ]
          },
          {
            "type": "checkpoint",
            "mode": "self_check",
            "prompt": "A pass/fail model makes 20 predictions and 17 are right. What is its accuracy?",
            "explanation": "17 / 20 = 0.85, or 85%."
          },
          {
            "type": "heading",
            "level": 2,
            "text": "Quick recap"
          },
          {
            "type": "list",
            "ordered": false,
            "items": [
              "Error metrics measure distance from the truth; accuracy metrics count correct predictions."
            ]
          }
        ]
      }
    }
