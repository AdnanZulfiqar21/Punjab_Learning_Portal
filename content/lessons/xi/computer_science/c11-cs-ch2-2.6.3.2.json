      "body": {
        "blocks": [
          {
            "type": "paragraph",
            "text": "Slicing allows you to access a subset of a sequence. The syntax for slicing is sequence [start: stop: step], where start is the starting index, stop is the ending index (not inclusive), and step is the step size."
          }
        ]
      }
