      "body": {
        "blocks": [
          {
            "type": "paragraph",
            "text": "Use a list for an ordered collection when order matters and direct access by index is also needed: dynamic arrays where elements are often added or removed, sequences such as a to-do list or playlist, and as the building block for stacks, queues and other structures."
          }
        ]
      }
