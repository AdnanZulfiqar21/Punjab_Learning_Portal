            "type": "callout",
            "tone": "definition",
            "title": "Assignment operators",
            "text": "Assignment operators variables ko qeematein dete hain. Bunyadi = hai, jo daen taraf ki qeemat baen taraf ke variable ko deta hai; murakkab operators jaise +=, -=, *= aur /= hisab ke amal ko assignment ke saath milate hain."
          },
          {
            "type": "table",
            "caption": "Assignment operators, a = 10 aur b = 5 se shuru (har line naya a leti hai)",
            "header": [
              "Statement",
              "Maani",
              "Baad mein a"
            ],
            "rows": [
              [
                "a += b",
                "a = a + b",
                "15"
              ],
              [
                "a -= b",
                "a = a - b",
                "10"
              ],
              [
                "a *= b",
                "a = a * b",
                "50"
              ],
              [
                "a /= b",
                "a = a / b",
                "10.0"
              ],
              [
                "a //= b",
                "a = a // b",
                "2.0"
              ],
              [
                "a %= b",
                "a = a % b",
                "2.0"
              ],
              [
                "a **= b",
                "a = a ** b",
                "32.0"
              ]
            ]
