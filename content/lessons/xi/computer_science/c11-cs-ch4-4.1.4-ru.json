            "type": "callout",
            "tone": "definition",
            "title": "Queue",
            "text": "Queue cheezein aise rakhti hai ke pehle judi cheez pehle nikle, yaani First-In, First-Out (FIFO) usool. Cheezein peeche jurti aur aage se nikalti hain, jaise bank ya ticket counter ki qataar."
          },
          {
            "type": "checkpoint",
            "mode": "self_check",
            "prompt": "Queue mein pehle kis ki khidmat hoti hai, aur naya aane wala kahan lagta hai?",
            "explanation": "Aage wala shakhs, jo pehle aaya; naya aane wala peeche lagta hai."
          },
          {
            "type": "heading",
            "level": 2,
            "text": "Fauri khulasa"
          },
          {
            "type": "list",
            "ordered": false,
            "items": [
              "Queue: peeche jorein, aage se nikalein; First-In, First-Out."
            ]
          }
        ]
      }
