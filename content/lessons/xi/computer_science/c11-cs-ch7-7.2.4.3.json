          {
            "type": "callout",
            "tone": "definition",
            "title": "Cookie management",
            "text": "Managing cookies means deciding which cookies to keep and which to delete."
          },
          {
            "type": "paragraph",
            "text": "Keep cookies from a favourite shopping site so you stay logged in, but delete cookies from other sites to protect your privacy."
          },
          {
            "type": "checkpoint",
            "mode": "self_check",
            "prompt": "Where can you manage cookies?",
            "explanation": "In the browser's privacy or cookie settings, and on a site's cookie-consent banner."
          },
          {
            "type": "heading",
            "level": 2,
            "text": "Quick recap"
          },
          {
            "type": "list",
            "ordered": false,
            "items": [
              "Manage cookies: keep the useful ones, delete tracking ones."
            ]
          }
        ]
      }
    }
