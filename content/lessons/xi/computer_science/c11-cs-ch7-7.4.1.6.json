      "body": {
        "blocks": [
          {
            "type": "paragraph",
            "text": "Red flags are signs that indicate a source might be unreliable. These include lack of author information, sensational headlines, or sources that do not cite their references."
          },
          {
            "type": "paragraph",
            "text": "Example: A website with no clear author or contact information might be unreliable."
          }
        ]
      }
    }
  ]
