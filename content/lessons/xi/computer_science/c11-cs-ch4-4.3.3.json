      "body": {
        "blocks": [
          {
            "type": "paragraph",
            "text": "BFS uses a queue to explore all nodes at the present depth before the next level, which makes it ideal for finding shortest paths in unweighted graphs or exploring connections level by level. On the same tree (Figure 4.13):"
          },
          {
            "type": "table",
            "caption": "BFS queue trace",
            "header": [
              "Step",
              "Dequeue and visit",
              "Queue after (front on the left)"
            ],
            "rows": [
              [
                "1",
                "1, enqueue 2, 3, 4",
                "[2, 3, 4]"
              ],
              [
                "2",
                "2, enqueue 5, 6",
                "[3, 4, 5, 6]"
              ],
              [
                "3",
                "3, enqueue 7",
                "[4, 5, 6, 7]"
              ],
              [
                "4",
                "4, enqueue 8, 9",
                "[5, 6, 7, 8, 9]"
              ],
              [
                "5",
                "5",
                "[6, 7, 8, 9]"
              ],
              [
                "6",
                "6",
                "[7, 8, 9]"
              ],
              [
                "7",
                "7",
                "[8, 9]"
              ],
              [
                "8",
                "8",
                "[9]"
              ],
              [
                "9",
                "9",
                "[] (done)"
              ]
            ]
          },
          {
            "type": "paragraph",
            "text": "The BFS order is 1, 2, 3, 4, 5, 6, 7, 8, 9."
          }
        ]
      }
    }
  ]
