      "body": {
        "blocks": [
          {
            "type": "paragraph",
            "text": "Assessing credibility means figuring out if the information is coming from an expert or someone with authority on the topic."
          },
          {
            "type": "paragraph",
            "text": "Example: Information about the sighting of the moon for Eid in Pakistan should come from the official Hilal Committee rather than from unverified sources on social media."
          }
        ]
      }
    }
  ]
}
