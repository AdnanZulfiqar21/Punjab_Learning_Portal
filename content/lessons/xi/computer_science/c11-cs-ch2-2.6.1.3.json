        "blocks": [
          {
            "type": "paragraph",
            "text": "List items can be changed by assigning a new value to an index, and new items can be added with append()."
          },
          {
            "type": "callout",
            "tone": "note",
            "title": "Python code (each .... is one 4-space indent)",
            "text": "fruits = [\"Mango\", \"Apple\", \"Banana\"]\nfruits[0] = \"Orange\"\nfruits.append(\"Pineapple\")\nprint(fruits)    # ['Orange', 'Apple', 'Banana', 'Pineapple']"
          },
          {
            "type": "checkpoint",
            "mode": "self_check",
            "prompt": "After these lines, how many items does fruits have and what is fruits[-1]?",
            "explanation": "Four items; fruits[-1] is 'Pineapple'."
          },
          {
            "type": "heading",
            "level": 2,
            "text": "Quick recap"
          },
          {
            "type": "list",
            "ordered": false,
            "items": [
              "Change an item with fruits[i] = value; add at the end with append()."
            ]
          }
