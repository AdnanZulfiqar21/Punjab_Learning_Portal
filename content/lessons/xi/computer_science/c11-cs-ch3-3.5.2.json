            "tone": "definition",
            "title": "Scalability",
            "text": "Scalability is an algorithm's ability to stay efficient as the input data grows, even far beyond the size it was first designed for."
          },
          {
            "type": "checkpoint",
            "mode": "self_check",
            "prompt": "Why does binary search scale better than linear search?",
            "explanation": "Its time grows as log n: a million sorted items need only about 20 checks, while linear search may need a million."
          },
