        }
      ],
      "body": {
        "blocks": [
          {
            "type": "paragraph",
            "text": "List ka item badalne ke liye us ke index se usay pakrein aur nayi value assign kar dein (rakh dein). Misaal: pehla item \"Orange\" kar dein aur naya phal \"Pineapple\" jor dein."
          },
          {
            "type": "code",
            "language": "python",
            "text": "fruits = [\"Mango\", \"Apple\", \"Banana\"]\nfruits [0] = \"Orange\"\nfruits.append(\"Pineapple\")\nprint(fruits)\n# Output: ['Orange', 'Apple', 'Banana', 'Pineapple']",
            "runnable": true
          },
          {
            "type": "paragraph",
            "text": "Wazahat: fruits[0] = \"Orange\" pehla item badal deta hai, append(\"Pineapple\") aakhir mein naya item jorta hai, aur phir nayi list print hoti hai: ['Orange', 'Apple', 'Banana', 'Pineapple']."
          },
          {
            "type": "checkpoint",
            "mode": "self_check",
            "prompt": "In lines ke baad fruits mein kitni cheezein hain aur fruits[-1] kya hai?",
            "explanation": "Chaar cheezein; fruits[-1] 'Pineapple' hai."
          },
          {
            "type": "heading",
            "level": 2,
            "text": "Mukhtasar khulasa"
          },
          {
            "type": "list",
            "ordered": false,
            "items": [
              "list[index] = nayi value se badlein; append() se aakhir mein jorein."
            ]
          }
        ]
      }
    }
  ]
