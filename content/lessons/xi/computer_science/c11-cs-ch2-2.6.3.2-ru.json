      "body": {
        "blocks": [
          {
            "type": "paragraph",
            "text": "Slicing se sequence ka ek hissa (subset) milta hai. Is ka syntax (likhne ka tareeqa) sequence[start:stop:step] hai: start shuru ka index, stop aakhri index (yeh khud shamil nahi hota), aur step (step size) yeh batata hai ke har baar kitna aage jana hai."
          },
          {
            "type": "checkpoint",
            "mode": "self_check",
            "prompt": "[10, 20, 30, 40, 50, 60, 70, 80][2:6] kya hai?",
            "explanation": "[30, 40, 50, 60]: index 2, 3, 4 aur 5, 6 se pehle ruk kar."
          },
          {
            "type": "heading",
            "level": 3,
            "text": "Khud chala kar dekhein"
          },
          {
            "type": "paragraph",
            "text": "start, stop aur step badal kar Run karein aur dekhein list aur string dono ka kaunsa hissa kat kar aata hai. stop wala index shamil nahi hota."
          },
          {
            "type": "code",
            "language": "python",
            "text": "numbers = [10, 20, 30, 40, 50, 60, 70, 80]\nword = \"Pakistan\"\nstart = 1\nstop = 4\nstep = 1\nprint(numbers[start:stop:step])\nprint(word[start:stop:step])",
            "runnable": true
          },
          {
            "type": "heading",
            "level": 2,
            "text": "Mukhtasar khulasa"
          },
          {
            "type": "list",
            "ordered": false,
            "items": [
              "sequence[start:stop:step]; stop shamil nahi."
            ]
          }
        ]
      }
    }
  ]
