      "external_id": "C12-CS-CH6-PRECISION-AND-RECALL",
      "chapter": "pk-punjab/xii/computer_science/c12-cs/ch6",
      "topic": "pk-punjab/xii/computer_science/c12-cs/ch6/u-precision-and-recall",
      "title": "Precision and Recall",
      "language": "en",
      "source_refs": [
        {
          "source_document_id": "87425af6-17db-594c-b23b-b9351886313c",
          "pdf_from": 85,
          "pdf_to": 85,
          "note": "'Precision and Recall' under topic 6.7, as printed (PDF 85, printed 81)."
        }
      ],
      "body": {
        "blocks": [
          {
            "type": "paragraph",
            "text": "Precision measures how many predicted positive results are actually correct. Recall measures how many actual positive cases are correctly identified. Precision focuses on correctness. Recall focuses on completeness. High precision reduces false results. High recall reduces missed cases."
          },
          {
            "type": "paragraph",
            "text": "Precision Equation:"
          },
          {
            "type": "equation",
            "latex": "\\text{Precision} = \\frac{\\text{TP}}{\\text{TP} + \\text{FP}}",
            "text_alt": "Precision = TP / (TP + FP)"
          },
          {
            "type": "list",
            "ordered": false,
            "items": [
              "TP (True Positives): Correctly predicted positive instances.",
              "FP (False Positives): Incorrectly predicted positive instances."
            ]
          },
          {
            "type": "paragraph",
            "text": "Recall Equation:"
          },
          {
            "type": "equation",
            "latex": "\\text{Recall} = \\frac{\\text{TP}}{\\text{TP} + \\text{FN}}",
            "text_alt": "Recall = TP / (TP + FN)"
          },
          {
            "type": "list",
            "ordered": false,
            "items": [
              "TP (True Positives): Correctly predicted positive instances.",
              "FN (False Negatives): Incorrectly predicted negative instances."
            ]
          }
        ]
      }
    }
  ]
}
