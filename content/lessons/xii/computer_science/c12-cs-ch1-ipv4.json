      "body": {
        "blocks": [
          {
            "type": "paragraph",
            "text": "Example: 192.168.1.10"
          },
          {
            "type": "paragraph",
            "text": "IPv4 has 4 numbers, each 0–255, separated by dots."
          },
          {
            "type": "paragraph",
            "text": "Each number = 1 Byte = 8 bits"
          },
          {
            "type": "paragraph",
            "text": "Total = 32 bits"
          },
          {
            "type": "table",
            "caption": "Breakdown of IPv4",
            "header": [
              "Part",
              "Value",
              "What it means"
            ],
            "rows": [
              [
                "Network part",
                "192.168.1",
                "Identifies your local network, like “Gulshan Block Street 3”"
              ],
              [
                "Host part",
                "10",
                "Identifies your specific device on that network, like “House #10”"
              ]
            ]
          },
          {
            "type": "callout",
            "tone": "note",
            "title": "Do You Know?",
            "text": "Total IPv4 addresses possible: 4.29 billion"
          }
