      "body": {
        "blocks": [
          {
            "type": "paragraph",
            "text": "Ketones are prepared by the oxidation of secondary alcohols."
          },
          {
            "type": "equation",
            "latex": "\\underset{\\text{propan-2-ol}}{\\ce{CH3-CH(OH)-CH3}} + \\ce{[O] ->[K2Cr2O7 + H2SO4][\\text{Heat}]} \\underset{\\text{propanone}}{\\ce{CH3-CO-CH3}} + \\ce{H2O}",
            "text_alt": "CH₃–CH(OH)–CH₃ (propan-2-ol) + [O] → CH₃–CO–CH₃ (propanone) + H₂O (K₂Cr₂O₇ + H₂SO₄, Heat)"
          }
        ]
      }
    }
  ]
