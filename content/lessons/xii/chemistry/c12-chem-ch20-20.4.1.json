      "body": {
        "blocks": [
          {
            "type": "paragraph",
            "text": "When benzene burns in excess air it is completely oxidised to carbon dioxide and water: 2C6H6 + 15O2 -> 12CO2 + 6H2O. The flame is very smoky, which is used as a test for aromatic compounds."
          }
        ]
      }
