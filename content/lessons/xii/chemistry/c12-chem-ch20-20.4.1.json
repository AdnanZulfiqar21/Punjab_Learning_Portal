        "blocks": [
          {
            "type": "paragraph",
            "text": "When benzene is burnt in excess of air, it is completely oxidized to CO₂ and H₂O. However, this reaction gives a smoky flame which is used as a test for aromatic compounds."
          },
          {
            "type": "equation",
            "latex": "\\ce{2C6H6 + 15O2 -> 12CO2 + 6H2O}",
            "text_alt": "2C₆H₆ + 15O₂ → 12CO₂ + 6H₂O"
          }
        ]
      }
