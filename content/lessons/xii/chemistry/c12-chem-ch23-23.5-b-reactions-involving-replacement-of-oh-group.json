      "external_id": "C12-CHEM-CH23-23.5-B-REACTIONS-INVOLVING-REPLACEMENT-OF-OH-GROUP",
      "chapter": "pk-punjab/xii/chemistry/c12-chem/ch23",
      "topic": "pk-punjab/xii/chemistry/c12-chem/ch23/u-b-reactions-involving-replacement-of-oh-group",
      "title": "B. Reactions involving replacement of -OH group",
      "language": "en",
      "source_refs": [
        {
          "source_document_id": "2d720c54-503b-58ec-b5b1-3307f222f40c",
          "pdf_from": 110,
          "pdf_to": 110,
          "note": "B. Reactions involving replacement of -OH group: a main subheading of 23.5 Reactions of Carboxylic Acids, its own page (owner 2026-11-04); PDF 110-110."
        }
      ],
      "body": {
        "blocks": [
          {
            "type": "paragraph",
            "text": "Carboxylic acids can undergo substitution reactions in which the OH group is replaced by some other group like X, OR, NH₂ etc."
          },
          {
            "type": "heading",
            "level": 4,
            "text": "a) Reaction with SOCl₂, PCl₃ and PCl₅"
          },
          {
            "type": "equation",
            "latex": "\\ce{CH3-COOH + SOCl2 -> CH3-COCl + HCl + SO2}",
            "text_alt": "CH₃–COOH + SOCl₂ → CH₃–COCl + HCl + SO₂"
          },
          {
            "type": "equation",
            "latex": "\\ce{CH3-COOH + PCl5 -> CH3-COCl + HCl + POCl3}",
            "text_alt": "CH₃–COOH + PCl₅ → CH₃–COCl + HCl + POCl₃"
          },
          {
            "type": "heading",
            "level": 4,
            "text": "b) Reaction with alcohols (Esterification)"
          },
          {
            "type": "paragraph",
            "text": "Carboxylic acids on heating with alcohols in the presence of concentrated sulphuric acid produce esters."
          },
          {
            "type": "equation",
            "latex": "\\underset{\\text{ethanoic acid}}{\\ce{CH3-COOH}} + \\underset{\\text{ethanol}}{\\ce{C2H5OH}} \\ce{<=>[H2SO4]} \\underset{\\text{ethyl ethanoate}}{\\ce{CH3-COOC2H5}} + \\ce{H2O}",
            "text_alt": "CH₃–COOH (ethanoic acid) + C₂H₅OH (ethanol) ⇌ CH₃–COOC₂H₅ (ethyl ethanoate) + H₂O (H₂SO₄)"
          }
        ]
      }
    }
  ]
}
