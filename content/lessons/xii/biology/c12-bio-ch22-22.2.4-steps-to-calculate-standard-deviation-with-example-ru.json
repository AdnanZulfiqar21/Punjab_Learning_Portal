              6
            ]
          },
          {
            "type": "equation",
            "latex": "\\sigma = \\sqrt{\\frac{784}{9}} = \\sqrt{87.11} = 9.33\\ \\text{cm}",
            "text_alt": "σ = √(784/9) = √87.11 = 9.33 cm"
          },
          {
            "type": "callout",
            "tone": "tip",
            "text": "Murabbon ka jama 784 hai; 9 qeematon par taqseem karne se variance 87.11 aata hai, aur us ka square root 9.33 cm hai. Yani in paudon ki unchai aam taur par ausat (75 cm) se taqreeban 9 cm upar ya neeche hai.",
            "title": "Asaan alfaaz mein"
          },
          {
            "type": "checkpoint",
            "mode": "self_check",
            "prompt": "Paudon ke do set ki ausat unchai barabar hai. Set X ki SD 2 cm aur set Y ki SD 9 cm hai. Kis set ke paude unchai mein zyada aik jaise (yaksaan) hain?",
            "explanation": "Set X ke, kyunke kam standard deviation ka matlab hai ke us ki unchaiyan mean ke zyada qareeb hain."
          },
          {
            "type": "heading",
            "level": 2,
            "text": "Mukhtasar khulasa"
          },
          {
            "type": "list",
            "ordered": false,
            "items": [
              "SD = √[Σ(xᵢ − µ)² / N]: mean se farq ka murabba, un ki average (variance), phir square root.",
              "Paudon ki misaal: mean 75 cm, variance 87.11, SD 9.33 cm.",
              "Kam SD: data ghana (mean ke qareeb); zyada SD: data phaila hua."
            ]
          }
        ]
      }
