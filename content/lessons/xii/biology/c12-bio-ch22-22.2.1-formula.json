  "items": [
    {
      "external_id": "C12-BIO-CH22-22.2.1-FORMULA",
      "chapter": "pk-punjab/xii/biology/c12-bio/ch22",
      "topic": "pk-punjab/xii/biology/c12-bio/ch22/u-formula",
      "title": "Formula",
      "language": "en",
      "source_refs": [
        {
          "source_document_id": "779562c7-0658-5de6-b1a6-2ee025d3b016",
          "pdf_from": 189,
          "pdf_to": 191,
          "note": "Formula: a main subheading of 22.2.1 Mean, its own page (owner 2026-11-04); PDF 189-191."
        }
      ],
      "body": {
        "blocks": [
          {
            "type": "heading",
            "level": 4,
            "text": "For ungrouped data"
          },
          {
            "type": "equation",
            "latex": "\\text{Mean} = \\frac{\\sum x}{n}",
            "text_alt": "Mean = Σx / n"
          },
          {
            "type": "paragraph",
            "text": "Where,"
          },
          {
            "type": "paragraph",
            "text": "Σx = sum of all the values."
          },
          {
            "type": "paragraph",
            "text": "n = number of values in the dataset."
          },
          {
            "type": "heading",
            "level": 4,
            "text": "For grouped data"
          },
          {
            "type": "equation",
            "latex": "\\text{Mean} = \\frac{\\sum_{i=1}^{n} f_i x_i}{\\sum_{i=1}^{n} f_i}",
            "text_alt": "Mean = Σᵢ₌₁ⁿ fᵢxᵢ / Σᵢ₌₁ⁿ fᵢ"
          },
          {
            "type": "paragraph",
            "text": "Where:"
          },
          {
            "type": "paragraph",
            "text": "xᵢ = midpoint of the ith class interval."
          },
          {
            "type": "paragraph",
            "text": "fᵢ = frequency of the ith class."
          },
          {
            "type": "paragraph",
            "text": "Σfᵢ = sum of all the frequencies."
          },
          {
            "type": "heading",
            "level": 4,
            "text": "Steps to calculate the Mean (for ungrouped data)"
          },
          {
            "type": "paragraph",
            "text": "A biologist measured the average weight of a specific species of bird in a park. He recorded the weights (g) of five birds from the same species. The bird’s weights are 400g, 420g, 470g, 390g and 460g."
          },
          {
            "type": "paragraph",
            "text": "Step 1: Add all the weights together (ΣX)",
            "bold": [
              "Step 1:"
            ]
          },
          {
            "type": "paragraph",
            "text": "ΣX = 400+420+470+390+460 = 2140 g"
          },
          {
            "type": "paragraph",
            "text": "Step 2: Count the total number of birds (n)",
            "bold": [
              "Step 2:"
            ]
          },
          {
            "type": "paragraph",
            "text": "n = 5 birds"
          },
          {
            "type": "paragraph",
            "text": "Step 3: Divide the sum of bird’s weights by the number of birds",
            "bold": [
              "Step 3:"
            ]
          },
          {
            "type": "paragraph",
            "text": "Mean = ΣX/n = 2140/5 = 428g"
          },
          {
            "type": "paragraph",
            "text": "The average weight of a specific species of birds is 428g."
          },
          {
            "type": "heading",
            "level": 4,
            "text": "Steps to calculate the Mean (for grouped data)"
          },
          {
            "type": "paragraph",
            "text": "A biologist studied the growth of a certain plant species under different soil conditions. The plant heights (cm) are grouped into class intervals based on measurements from different plots of land with varying soil types."
          },
          {
            "type": "paragraph",
            "text": "Step 1: Organize the data set into class intervals.",
            "bold": [
              "Step 1:"
            ]
          },
          {
            "type": "paragraph",
            "text": "Step 2: Calculate the midpoint of each class interval.",
            "bold": [
              "Step 2:"
            ]
          },
          {
            "type": "paragraph",
            "text": "Step 3: Multiply each midpoint by its corresponding frequency.",
            "bold": [
              "Step 3:"
            ]
          },
          {
            "type": "paragraph",
            "text": "Step 4: Sum the products of midpoints and frequencies.",
            "bold": [
              "Step 4:"
            ]
          },
          {
            "type": "paragraph",
            "text": "Step 5: Divide the result of the step 4 by the total frequency.",
            "bold": [
              "Step 5:"
            ]
          },
          {
            "type": "table",
            "caption": "Table: Mean plant height (cm) calculation using grouped data across soil types.",
            "header": [
              "Soil Type",
              "Class Interval (Height in cm)",
              "Frequency (fᵢ)",
              "Midpoint (xᵢ = lower limit + upper limit / 2)",
              "fᵢ,xᵢ"
            ],
            "rows": [
              [
                "Sandy Soil",
                "0 – 10",
                "5",
                "5",
                "25"
              ],
              [
                "Loamy Soil",
                "10 – 20",
                "8",
                "15",
                "120"
              ],
              [
                "Clayey Soil",
                "20 – 30",
                "7",
                "25",
                "175"
              ],
              [
                "Peaty Soil",
                "30 – 40",
                "4",
                "35",
                "140"
              ],
              [
                "Median",
                "",
                "Σfᵢ = 24",
                "",
                "Σfᵢxᵢ = 4601"
              ]
            ],
            "book_errors": [
              "Median",
              "4601",
              "lower limit + upper limit / 2"
            ],
            "bold": [
              "Median"
            ]
          },
          {
            "type": "callout",
            "tone": "correction",
            "text": "The last row of the table gives the totals, not the median: Σfᵢ = 24 and Σfᵢxᵢ = 25 + 120 + 175 + 140 = 460 (the book prints the label 'Median' and the value 4601). The calculation below uses 460. The midpoint in the header also needs brackets: xᵢ = (lower limit + upper limit) / 2, which gives the table's values 5, 15, 25 and 35.",
            "title": "Book correction"
          },
          {
            "type": "equation",
            "latex": "\\begin{aligned} \\text{Mean} &= \\frac{\\sum f_i x_i}{\\sum f_i} \\\\ &= \\frac{460}{24} = 19.16667 \\approx 19.17\\,(\\text{cm}) \\end{aligned}",
            "text_alt": "Mean = Σfᵢxᵢ / Σfᵢ = 460/24 = 19.16667 ≈ 19.17 (cm)"
          },
          {
            "type": "paragraph",
            "text": "The average growth of a certain plant species under different soil conditions is 19.17cm."
          }
        ]
      }
    }
  ]
}
