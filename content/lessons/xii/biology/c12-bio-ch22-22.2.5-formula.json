    {
      "external_id": "C12-BIO-CH22-22.2.5-FORMULA",
      "chapter": "pk-punjab/xii/biology/c12-bio/ch22",
      "topic": "pk-punjab/xii/biology/c12-bio/ch22/u-formula~5",
      "title": "Formula",
      "language": "en",
      "source_refs": [
        {
          "source_document_id": "779562c7-0658-5de6-b1a6-2ee025d3b016",
          "pdf_from": 195,
          "pdf_to": 196,
          "note": "Formula: a main subheading of 22.2.5 Range, its own page (owner 2026-11-04); PDF 195-196."
        }
      ],
      "body": {
        "blocks": [
          {
            "type": "equation",
            "latex": "\\text{Range} = X_{\\max} - X_{\\min}",
            "text_alt": "Range = Xₘₐₓ − Xₘᵢₙ"
          },
          {
            "type": "paragraph",
            "text": "Where:"
          },
          {
            "type": "paragraph",
            "text": "Xₘₐₓ = maximum value in the data set."
          },
          {
            "type": "paragraph",
            "text": "Xₘᵢₙ = minimum value in the data set."
          },
          {
            "type": "heading",
            "level": 4,
            "text": "Steps to calculate the Range with example"
          },
          {
            "type": "paragraph",
            "text": "Consider a dataset representing the ages of a group of people: 25, 20, 22, 30, 42, 45, 50."
          },
          {
            "type": "paragraph",
            "text": "Step 1: Arrange the data in ascending order.",
            "bold": [
              "Step 1:"
            ]
          },
          {
            "type": "paragraph",
            "text": "20, 22, 25, 30, 42, 45, 50"
          },
          {
            "type": "paragraph",
            "text": "Step 2: Identify the greatest value in the dataset.",
            "bold": [
              "Step 2:"
            ]
          },
          {
            "type": "paragraph",
            "text": "50"
          },
          {
            "type": "paragraph",
            "text": "Step 3: Identify the smallest value in the dataset.",
            "bold": [
              "Step 3:"
            ]
          },
          {
            "type": "paragraph",
            "text": "20"
          },
          {
            "type": "paragraph",
            "text": "Step 4: Subtract the maximum value from the minimum value to calculate the range.",
            "bold": [
              "Step 4:"
            ],
            "book_errors": [
              "Subtract the maximum value from the minimum value"
            ]
          },
          {
            "type": "paragraph",
            "text": "Range = Xₘₐₓ − Xₘᵢₙ"
          },
          {
            "type": "paragraph",
            "text": "Range = 50-20 = 30"
          },
          {
            "type": "callout",
            "tone": "correction",
            "text": "Step 4 should say: subtract the minimum value from the maximum value (Xₘₐₓ − Xₘᵢₙ), as the formula and the book's own working (50 − 20 = 30) do.",
            "title": "Book correction"
          }
        ]
      }
    }
  ]
}
