      "external_id": "C12-BIO-CH22-22.2.3-STEPS-TO-CALCULATE-THE-MODE-FOR-GROUPED-DATA-WITH-EXAMPLE",
      "chapter": "pk-punjab/xii/biology/c12-bio/ch22",
      "topic": "pk-punjab/xii/biology/c12-bio/ch22/u-steps-to-calculate-the-mode-for-grouped-data-with-example",
      "title": "Steps to calculate the Mode for grouped data with example",
      "language": "en",
      "source_refs": [
        {
          "source_document_id": "779562c7-0658-5de6-b1a6-2ee025d3b016",
          "pdf_from": 193,
          "pdf_to": 194,
          "note": "Steps to calculate the Mode for grouped data with example: a main subheading of 22.2.3 Mode, its own page (owner 2026-11-04); PDF 193-194."
        }
      ],
      "body": {
        "blocks": [
          {
            "type": "paragraph",
            "text": "Consider we are studying the weight (kg) distribution of animals in a zoo."
          },
          {
            "type": "table",
            "caption": "Weight (kg) distribution of animals in a zoo",
            "header": [
              "Class",
              "Class interval Weight (kg)",
              "Frequency"
            ],
            "rows": [
              [
                "I",
                "10-20",
                "5"
              ],
              [
                "II",
                "20-30",
                "12"
              ],
              [
                "III",
                "30-40",
                "18"
              ],
              [
                "IV",
                "40-50",
                "10"
              ],
              [
                "V",
                "50-60",
                "3"
              ]
            ]
          },
          {
            "type": "paragraph",
            "text": "Step 1: Identify the modal class.",
            "bold": [
              "Step 1:"
            ]
          },
          {
            "type": "paragraph",
            "text": "The class interval (30-40) Class III is the modal class with the highest frequency (18)."
          },
          {
            "type": "paragraph",
            "text": "Step 2: Put the values in the formula to calculate mode for grouped data.",
            "bold": [
              "Step 2:"
            ]
          },
          {
            "type": "paragraph",
            "text": "l =30 (lower boundary of the modal class)"
          },
          {
            "type": "paragraph",
            "text": "fm =18 (frequency of the modal class)"
          },
          {
            "type": "paragraph",
            "text": "f₁ =12 (frequency of the class before the modal class)"
          },
          {
            "type": "paragraph",
            "text": "f₂ =10 (frequency of the class after the modal class)"
          },
          {
            "type": "paragraph",
            "text": "h =10 (class width)"
          },
          {
            "type": "equation",
            "latex": "\\begin{aligned} \\text{Mode} &= l + \\frac{(fm - f_1)}{(fm - f_1) + (fm - f_2)} \\times h \\\\ &= 30 + \\frac{(18 - 12)}{(18 - 12) + (18 - 10)} \\times 10 \\\\ &= 30 + \\frac{6}{6 + 8} \\times 10 = 30 + \\frac{6}{14} \\times 10 \\\\ &= 34.29\\,\\text{kg} \\end{aligned}",
            "text_alt": "Mode = l + (fm − f₁) / [(fm − f₁) + (fm − f₂)] × h = 30 + (18 − 12) / [(18 − 12) + (18 − 10)] × 10 = 30 + 6/(6 + 8) × 10 = 30 + 6/14 × 10 = 34.29 kg"
          },
          {
            "type": "paragraph",
            "text": "The mode of the givens dataset is 34.29 kg."
          }
        ]
      }
    }
  ]
}
