          {
            "type": "equation",
            "latex": "\\sigma = \\sqrt{\\frac{\\sum (x_i - \\mu)^2}{N}}",
            "text_alt": "σ = √[Σ(xᵢ − µ)² / N]"
          },
          {
            "type": "paragraph",
            "text": "Yahan:"
          },
          {
            "type": "list",
            "ordered": false,
            "items": [
              "σ (sigma) = standard deviation",
              "xᵢ = data ki har alag qeemat",
              "µ (mu) = mean",
              "N = data ki kul qeematon ki tadaad."
            ]
          }
        ]
      }
