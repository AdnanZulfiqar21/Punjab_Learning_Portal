      "body": {
        "blocks": [
          {
            "type": "paragraph",
            "text": "A number of tests have been developed to diagnose disorders of the nervous system. Three important ones are electroencephalography (EEG), computed tomography (CT) and magnetic resonance imaging (MRI)."
          },
          {
            "type": "checkpoint",
            "mode": "self_check",
            "prompt": "Which of the three tests records electrical activity rather than making an image?",
            "explanation": "EEG (electroencephalography)."
          },
          {
            "type": "heading",
            "level": 2,
            "text": "Quick recap"
          },
          {
            "type": "list",
            "ordered": false,
            "items": [
              "Diagnostic tests: EEG, CT, MRI."
            ]
          }
